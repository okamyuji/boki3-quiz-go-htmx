# 秘密値と環境依存値の記入例です。このファイルをコピーして secrets.auto.tfvars を作り、
# 実際の値を記入してください。secrets.auto.tfvars はgitignore済みで追跡しません。
# terraformはsecrets.auto.tfvarsを自動で読み込みます。
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#   （エディタで各値を記入）

# DNSとAccessとOrigin CA証明書を操作するユーザーAPIトークンです。
# feedflowのデプロイで発行済みのトークンをそのまま使えます。権限の目安は次のとおりです。
#   ゾーン     - DNS                 - 編集     （ゾーン: okamyuji.work）
#   ゾーン     - ゾーン               - 読み取り （ゾーン: okamyuji.work）
#   ゾーン     - SSL and Certificates - 編集     （ゾーン: okamyuji.work）
#   アカウント - Access: Apps         - 編集
#   アカウント - Access: Policies     - 編集
cloudflare_api_token = "ここにAPIトークン"

# CloudflareのアカウントIDです。ダッシュボード右側のサイドバーやAPIで確認できます。
cloudflare_account_id = "ここにアカウントID"

# 同居先EC2のElastic IPです。feedflowリポジトリの deploy/terraform で
# terraform output -raw elastic_ip を実行して取得します。
origin_public_ip = "ここにEIP"

# 既定で問題なければ以下は省略可能です。必要なら上書きしてください。
# zone_name            = "okamyuji.work"
# hostname             = "boki3.okamyuji.work"
# access_owner_email   = "owner@example.com"
# ssh_private_key_path = "../../../feedflow-go-htmx/deploy/terraform/feedflow_ssh_key.pem"
