# boki3-quizのサーバブロックです。feedflowのnginx (conf.d全体をincludeする構成) へ
# ドロップインで追加されます。CloudflareプロキシとAccessの背後で動きます。
# このファイルはterraformのtemplatefileでEC2上にだけ生成し配置します。
#
# real_ip系のうちreal_ip_headerはfeedflow.confがhttpコンテキストで宣言済みのため、
# 重複宣言を避けてserverコンテキスト内にのみ書きます。

# HTTPは443へ恒久リダイレクトします。
server {
    listen 80;
    listen [::]:80;
    server_name ${hostname};

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS終端です。証明書はboki3用のCloudflare Origin CAのものを使います。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${hostname};

    ssl_certificate     /etc/feedflow/tls/boki3.crt;
    ssl_certificate_key /etc/feedflow/tls/boki3.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Cloudflareエッジからの接続元IPを実クライアントIPへ復元します。
${real_ip_from_block}
    real_ip_header CF-Connecting-IP;

    # セキュリティヘッダです。アプリ側でも付与しますが前段でも保証します。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # boki3のコンテナは別composeプロジェクトのため、Docker内蔵DNSで遅延解決します。
    # 変数経由のproxy_passにすることで、boki3が停止していてもnginx自体の起動・reloadは
    # 失敗せず、feedflowを巻き込みません (boki3側だけ502になります)。
    resolver 127.0.0.11 valid=30s;
    set $boki3_upstream boki3-app:8080;

    location / {
        proxy_pass http://$boki3_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
    }
}
